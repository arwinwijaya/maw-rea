<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".CatatanApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.transaction.TransactionActivity"
            android:label="@string/transaksi_baru"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.account.AccountsActivity"
            android:label="@string/akun" />
        <activity
            android:name=".ui.summary.SummaryActivity"
            android:label="@string/ringkasan" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:label="@string/pengaturan" />
    </application>
</manifest>
